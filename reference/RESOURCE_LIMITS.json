{
  "schema": 1,
  "owner": "product-runtime",
  "platform": "macOS arm64 + Chromium",
  "limits": {
    "daemonRequestBytes": 196608,
    "messageBytes": 65536,
    "attachmentBytes": 33554432,
    "attachmentChunkBytes": 65536,
    "encryptedRecordCount": 4096,
    "encryptedRecordValueBytes": 4194304,
    "messagePageSize": 200,
    "automaticRetriesPerTick": 2,
    "maintenanceIntervalSeconds": 15
  },
  "acceptanceBudgets": {
    "idleCpuPercent": 5,
    "activeCpuPercent": 70,
    "rssMegabytes": 300,
    "startupSeconds": 5,
    "reconnectSeconds": 600
  },
  "runtimeMeasurement": {
    "command": "AD_DAEMON_BINARY=.build-cache/cargo-target/debug/another-dimension-daemon node scripts/acceptance_runtime_budget.mjs",
    "sampling": "짧은 시작 후 idle 1초와 정적 UI 요청 active 1초를 ps 누적 CPU/RSS로 측정",
    "platform": "macOS arm64"
  }
}
