{
  "format": "another-dimension-product-boundary",
  "version": 1,
  "supportedProduct": "authenticated browser UI + local OpenMLS daemon + Rust user-owned relay",
  "candidateProduct": "apps/daemon local OpenMLS security daemon (implementation active; high-risk disabled)",
  "candidateProductPath": "apps/daemon",
  "forbiddenReleasePaths": [
    "apps/desktop-tauri",
    "apps/cli",
    "apps/engine",
    "crates/core",
    "crates/crypto",
    "crates/identity",
    "crates/pairing",
    "crates/protocol",
    "crates/storage",
    "crates/transport"
  ],
  "developmentOnlyModes": [
    "serveStatic",
    "AD_SERVE_UI=1"
  ],
  "highRiskAllowed": false,
  "transportPolicy": {
    "highRiskMode": "disabled",
    "supportedRoutes": [
      { "id": "loopback", "risk": "low-risk", "anonymity": false, "requires": ["local daemon or relay on loopback"] },
      { "id": "direct-https-low-risk", "risk": "low-risk", "anonymity": false, "requires": ["user-owned relay", "explicit TLS certificate pin"] }
    ],
    "visibleMetadata": ["client IP address", "relay destination", "request timing", "request frequency", "ciphertext and blob sizes"],
    "relayBounds": {
      "maxEnvelopeBytes": 98304,
      "maxInboxItems": 256,
      "maxEnvelopePostsPerMinute": 30,
      "maxBlobBytes": 33554432,
      "maxBlobTtlDays": 7
    },
    "notImplemented": ["onion routing", "traffic padding", "dummy traffic", "timing obfuscation", "global anonymity set"]
  },
  "requiredReleaseFiles": [
    "README.md",
    "README.ko.md",
    "SECURITY.md",
    "SBOM.cyclonedx.json",
    "RELEASE-PROVENANCE.json",
    "release-manifest.json",
    "reference/PRODUCT_BOUNDARY.md",
    "reference/product_boundary.json",
    "reference/SUPPORT_MATRIX.json",
    "apps/web/dist/index.html",
    "apps/web/dist/asset-integrity.json",
    "bin/another-dimension-relay",
    "bin/another-dimension-tools",
    "bin/another-dimension-daemon",
    "scripts/install_local_server.sh",
    "scripts/installed_launcher.sh",
    "scripts/build_release.sh"
  ],
  "nonClaims": [
    "anonymity",
    "secure deletion",
    "coercion resistance",
    "compromised-device protection",
    "independent audit"
  ]
}
