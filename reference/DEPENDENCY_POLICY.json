{
  "schema": 1,
  "policyOwner": "product-security",
  "purpose": "The product dependency boundary is intentionally small and every direct dependency has a reviewed reason.",
  "allowedRustLicenses": [
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "CDLA-Permissive-2.0",
    "ISC",
    "MIT",
    "MPL-2.0",
    "Unicode-DFS-2016",
    "Unlicense",
    "Zlib"
  ],
  "rust": {
    "direct": {
      "aes-gcm": { "owner": "crypto", "purpose": "AEAD for local encrypted state and attachments", "defaultFeatures": false },
      "argon2": { "owner": "crypto", "purpose": "Argon2id passphrase key derivation", "defaultFeatures": false },
      "axum": { "owner": "daemon", "purpose": "Authenticated loopback HTTP API", "defaultFeatures": false },
      "ed25519-dalek": { "owner": "identity", "purpose": "Account and pairing signature verification", "defaultFeatures": false },
      "getrandom": { "owner": "crypto", "purpose": "Operating-system randomness for key material", "defaultFeatures": true },
      "openmls": { "owner": "protocol", "purpose": "IETF MLS conversation state machine", "defaultFeatures": false },
      "openmls_libcrux_crypto": { "owner": "protocol", "purpose": "OpenMLS cryptographic provider", "defaultFeatures": false },
      "openmls_traits": { "owner": "protocol", "purpose": "OpenMLS storage/provider interfaces", "defaultFeatures": false },
      "rustls": { "owner": "transport", "purpose": "TLS client validation and handshake", "defaultFeatures": false },
      "serde": { "owner": "protocol", "purpose": "Explicit wire/config serialization", "defaultFeatures": true },
      "serde_json": { "owner": "protocol", "purpose": "JSON boundary for local API and relay envelopes", "defaultFeatures": true },
      "sha2": { "owner": "crypto", "purpose": "Domain-separated transcript and digest operations", "defaultFeatures": true },
      "tokio": { "owner": "daemon", "purpose": "Bounded asynchronous runtime", "defaultFeatures": true },
      "tokio-rustls": { "owner": "transport", "purpose": "Rustls integration for relay TLS", "defaultFeatures": false },
      "tls_codec": { "owner": "protocol", "purpose": "Canonical TLS codec for protocol values", "defaultFeatures": true },
      "webpki-roots": { "owner": "transport", "purpose": "Pinned public WebPKI trust roots", "defaultFeatures": true },
      "zeroize": { "owner": "crypto", "purpose": "Best-effort clearing of secret buffers", "defaultFeatures": true },
      "security-framework": { "owner": "platform", "purpose": "macOS Keychain integration", "defaultFeatures": false }
    },
    "approvedTransitiveExceptions": {
      "MPL-2.0": "OpenMLS's hpke-rs provider is a reviewed weak-copyleft transitive dependency; it is not copied into the product and remains replaceable behind the provider boundary.",
      "CDLA-Permissive-2.0": "webpki-roots is required for the Rustls trust-root set and is permissive for this use.",
      "duplicate-crypto": "OpenMLS/libcrux currently brings compatible rand/getrandom/libcrux generations. Direct crypto crates must remain single-version; transitive duplicates are reported so upgrades cannot silently expand them."
    }
  },
  "node": {
    "allowedLicenses": ["0BSD", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MIT", "Unlicense", "Zlib"],
    "direct": {
      "vite": { "owner": "web-build", "purpose": "Local static browser bundle build", "license": "MIT" },
      "better-sqlite3": { "owner": "relay", "purpose": "Local relay durable queue storage", "license": "MIT" }
    },
    "registryOnly": true,
    "requireIntegrity": true,
    "requireInstalledLicenseScan": true
  },
  "forbiddenRuntimePatterns": [
    "eval",
    "new Function",
    "WebAssembly",
    "document.cookie",
    "localStorage",
    "sessionStorage",
    "external CDN or analytics"
  ]
}
